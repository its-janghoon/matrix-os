# Public bridge configuration for a Base Sepolia rehearsal (chain id 84532).
# This repository does not claim a live deployment. Replace the explicit
# placeholder below with the verified WrappedMatrix address from your deployment
# manifest before enabling bridge controls.
NEXT_PUBLIC_BASE_CHAIN_ID=84532
NEXT_PUBLIC_WRAPPED_MATRIX_ADDRESS=<DEPLOYED_BASE_SEPOLIA_WRAPPED_MATRIX_ADDRESS>
# Comma-separated, credential-free HTTPS Connect endpoints. Do not put API keys,
# userinfo, query-string credentials, or private validator/admin ports here.
NEXT_PUBLIC_MATRIX_VALIDATOR_URLS=https://validator-1.example.org,https://validator-2.example.org,https://validator-3.example.org
# Optional trusted HTTPS venue. Leave unset unless the operator has reviewed it.
# NEXT_PUBLIC_MATRIX_DEX_URL=https://dex.example.org/swap

# Base production overlay (chain id 8453). Keep this commented until the exact
# production contract and validator endpoints have been deployed and verified.
# NEXT_PUBLIC_BASE_CHAIN_ID=8453
# NEXT_PUBLIC_WRAPPED_MATRIX_ADDRESS=<DEPLOYED_BASE_WRAPPED_MATRIX_ADDRESS>
# NEXT_PUBLIC_MATRIX_VALIDATOR_URLS=https://validator-1.example.org,https://validator-2.example.org,https://validator-3.example.org
# NEXT_PUBLIC_MATRIX_DEX_URL=https://dex.example.org/swap

# Each matrixd endpoint must allow the exact public web origin in
# connect.allowed_origins (for example https://matrix.example.org; never "*")
# and enable connect.public_reads plus connect.signed_writes. CORS only permits
# that browser origin: public_reads exposes credential-free Get*/List* methods,
# while signed_writes accepts only client-signature-authorized writes. It does
# not expose FundAccount, provider registration, admin RPCs, or signing keys.
