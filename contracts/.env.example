# Matrix contracts — Base-primary launch/operator environment.
#
# Copy to `.env` (which is gitignored) and fill in YOUR values only while
# following docs/runbooks/base-launch.md. NEVER commit a real key, API key, or
# credential-bearing RPC URL. Every blank below is an unresolved input, not a
# usable default.

# --- RPC endpoints (from your node provider, e.g. Alchemy/Infura) ---
# Ethereum mainnet RPC (legacy production target).
MAINNET_RPC_URL=
# Sepolia testnet RPC.
SEPOLIA_RPC_URL=
# Base production RPC (primary target, chain id 8453).
BASE_RPC_URL=
# Base Sepolia RPC (bridge rehearsal, chain id 84532).
BASE_SEPOLIA_RPC_URL=
# Mainnet RPC used ONLY to fork mainnet state for the local dry-run/fork
# simulation. Setting this makes `npx hardhat test` run against forked mainnet.
MAINNET_FORK_RPC_URL=

# --- Deployer/mint-broadcaster key (hex, 0x-prefixed) ---
# Required on Base, Base Sepolia, and legacy real networks. The account pays its
# own EVM gas; there is no relayer or protocol gas sponsorship.
PRIVATE_KEY=

# --- Explorer source verification ---
# ONE key from https://etherscan.io/myapikey covers every chain, Base and Base
# Sepolia included, through the Etherscan V2 multichain API. Do not use a
# separate basescan.org key: the per-explorer V1 endpoints are retired and now
# answer "You are using a deprecated V1 endpoint" - which would only surface
# after a deploy has been broadcast and paid for.
ETHERSCAN_API_KEY=
# Legacy fallback, read only when ETHERSCAN_API_KEY is unset. Prefer the above.
BASESCAN_API_KEY=

# --- Bridge validator/attestor configuration ---
# Comma-separated immutable per-deployment secp256k1 EVM attestor
# addresses (the "n" of the m-of-n bridge). Native validator membership is a
# separate dynamic security domain: join/ejection does not rotate this list,
# and changing it requires a new WrappedMatrix deployment/migration. Required
# on every real network; there is no local fallback.
ATTESTORS=
# Distinct EVM-attestor signatures required to mint (the "m"). Base production
# requires n >= 2 and strictly >2/3 (3*m > 2*n); the deploy script enforces it.
THRESHOLD=


# Immutable wrapped-supply cap in 18-decimal base units. Required and non-zero
# on Base/mainnet. Approved Base launch cap: 6% of the native supply: 60M
# wrapped units, including the separately exact-backed 50M founder allocation.
MINT_CAP=60000000000000000000000000

# --- Immutable founder vesting (Base) ---
# Deployed wMATRIX token and founder beneficiary (prefer a Safe).
WMATRIX_ADDRESS=
FOUNDER_BENEFICIARY=
# Explicit Unix launch timestamp and whole-token allocation. Base production
# accepts VESTING_START only in the inclusive range from 5 minutes before to 5
# minutes after the latest Base block timestamp. Freeze it before deployment in
# the reviewed, non-secret FOUNDER_CEREMONY JSON; the production deploy and
# founder-only mint commands both require and compare that same file.
VESTING_START=
FOUNDER_ALLOCATION=50000000
# Absolute path to JSON containing exact network, chainId, token, beneficiary,
# start, cliffDuration, duration, and allocation (base-unit integer strings for
# chainId/allocation). Hash/sign and retain this file as ceremony evidence.
FOUNDER_CEREMONY=
# Used by the guarded mint and read-only status scripts after deployment.
VESTING_ADDRESS=
