# Matrix contracts - mainnet release harness environment.
#
# Copy to `.env` (which is gitignored) and fill in YOUR values. NEVER commit a
# real key, API key, or credential-bearing RPC URL. Every value below is a
# placeholder only.

# --- RPC endpoints (from your node provider, e.g. Alchemy/Infura) ---
# Ethereum mainnet RPC (production deploy target).
MAINNET_RPC_URL=
# Sepolia testnet RPC (dress rehearsal before mainnet).
SEPOLIA_RPC_URL=
# Mainnet RPC used ONLY to fork mainnet state for the local dry-run/fork
# simulation. Setting this makes `npx hardhat test` run against forked mainnet.
MAINNET_FORK_RPC_URL=

# --- Deployer key (hex, 0x-prefixed). Required for mainnet/sepolia. ---
# NEVER hardcode this in source or commit it. It is read from the environment
# only. The harness refuses to deploy to a real network when this is unset.
PRIVATE_KEY=

# --- Etherscan verification ---
ETHERSCAN_API_KEY=

# --- Bridge validator/attestor configuration ---
# Comma-separated secp256k1 attestor addresses (the "n" of the m-of-n bridge).
# These MUST match the secp256k1 keys the Go validators sign with
# (services/core/internal/bridge). Required on mainnet/sepolia (no local
# fallback allowed on real networks).
ATTESTORS=
# Number of distinct attestor signatures required to mint (the "m"). 1 <= m <= n.
THRESHOLD=
